    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--no-launch-profile", "--urls=http://localhost:5080"],
      "cwd": "CameraShop.API",
      "port": 5080
    }
  ]
}
